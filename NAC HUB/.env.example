POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=nac_hub
DATABASE_URL=postgresql://postgres:CHANGE_ME_SECURE_PASSWORD@db:5432/nac_hub
SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://host.docker.internal:5173"]

# --- AI Provider (nakkun) ---
# AI_PROVIDER: mock (default) or openai
# Put the real OPENAI_API_KEY ONLY in backend/.env.ai (git-ignored, backend-only). Never commit real values.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
