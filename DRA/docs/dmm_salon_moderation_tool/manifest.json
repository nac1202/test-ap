{
    "manifest_version": 3,
    "name": "DMM Salon Check Tool",
    "version": "1.2",
    "description": "DMMオンラインサロンの規約違反書き込みをAIでチェックするツール",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://salon.dmm.com/*",
        "https://api.openai.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://salon.dmm.com/*",
                "file:///*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ]
}